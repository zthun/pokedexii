{
  "name": "@zthun/pokedexii",
  "description": "Gotta catch 'em all.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/pokedexii"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@zthun/janitor-build-config": "^19.2.2",
    "@zthun/janitor-lint": "^19.2.3",
    "@zthun/janitor-lint-config": "^19.2.3",
    "@zthun/janitor-options": "^19.2.3",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lerna": "^8.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^6.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node@*",
    "vite": "^6.0.0"
  },
  "packageManager": "yarn@4.9.1"
}
